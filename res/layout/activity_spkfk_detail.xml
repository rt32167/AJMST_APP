<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ui_background" android:orientation="vertical" android:focusableInTouchMode="true">
    <requestFocus />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/ui_surface" android:gravity="center_vertical" android:padding="16dp" android:orientation="horizontal">
        <Button android:id="@+id/btnReturn" style="@style/UiSecondaryButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="返回" />
        <TextView style="@style/UiPageTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="16dp" android:text="商品详情" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/ui_card" android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/UiSectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="商品名称" />
                <TextView android:id="@+id/tvSpmch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/ui_text" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvShengccj" style="@style/UiMutedText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" />
                <TextView style="@style/UiSectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="商品信息" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <TextView style="@style/UiMutedText" android:layout_width="72dp" android:layout_height="wrap_content" android:text="商品编号" />
                    <TextView android:id="@+id/tvSpbh" style="@style/UiBodyText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                </LinearLayout>
                <LinearLayout android:id="@+id/rowSpecification" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <TextView style="@style/UiMutedText" android:layout_width="72dp" android:layout_height="wrap_content" android:text="规格" />
                    <TextView android:id="@+id/tvShpgg" style="@style/UiBodyText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                </LinearLayout>
                <LinearLayout android:id="@+id/rowUnit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <TextView style="@style/UiMutedText" android:layout_width="72dp" android:layout_height="wrap_content" android:text="单位" />
                    <TextView android:id="@+id/tvDw" style="@style/UiBodyText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <TextView style="@style/UiMutedText" android:layout_width="72dp" android:layout_height="wrap_content" android:text="内部 ID" />
                    <TextView android:id="@+id/tvSpid" style="@style/UiMutedText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/ui_card" android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/UiSectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="位置与价格" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView style="@style/UiMutedText" android:layout_width="72dp" android:layout_height="wrap_content" android:text="柜号" />
                    <TextView android:id="@+id/tvCabinetNo" style="@style/UiBodyText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <Button android:id="@+id/btnCabinet" style="@style/UiSecondaryButton" android:layout_width="wrap_content" android:layout_height="40dp" android:text="修改" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView style="@style/UiMutedText" android:layout_width="72dp" android:layout_height="wrap_content" android:text="零售价" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/tvLshj" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ui_price" android:textSize="20sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvPriceUnit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="3dp" android:text="/10g" android:textColor="@color/ui_muted" android:textSize="11sp" android:visibility="gone" />
                    </LinearLayout>
                    <Button android:id="@+id/btnLshj" style="@style/UiSecondaryButton" android:layout_width="wrap_content" android:layout_height="40dp" android:text="修改" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/ui_card" android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/UiSectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="商品条码" />
                <EditText android:id="@+id/etSptm" style="@style/UiInput" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:hint="输入商品条码" android:inputType="number" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <Button android:id="@+id/btnSptm" style="@style/UiSecondaryButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="扫码" />
                    <Button android:id="@+id/btnSptmByHand" style="@style/UiPrimaryButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginLeft="8dp" android:layout_weight="1" android:text="保存条码" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
