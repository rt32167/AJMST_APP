<?xml version="1.0" encoding="utf-8"?>
<com.ajmst.android.ui.RoundedPageLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<LinearLayout
    android:id="@+id/widget32"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <com.ajmst.android.ui.HeroHeaderLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingTop="10dp"
        android:paddingRight="12dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="商品查询"
                android:textColor="@color/ui_text"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvOrderAmount"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginRight="8dp"
                android:background="@drawable/ui_filter_button"
                android:gravity="center"
                android:paddingLeft="9dp"
                android:paddingRight="9dp"
                android:singleLine="true"
                android:text="合计 ¥0"
                android:textColor="@color/ui_accent_dark"
                android:textSize="16sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btnViewOrder"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/ui_filter_button"
                android:minHeight="36dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="销售单"
                android:textColor="@color/ui_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget33"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/ui_search_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="5dp"
            android:paddingRight="4dp">
            <EditText
                android:id="@+id/etZjm"
                style="@style/UiInput"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="输入商品首字母"
                android:inputType="textCapCharacters" />
            <Button
                android:id="@+id/btnSearch"
                style="@style/UiPrimaryButton"
                android:layout_width="64dp"
                android:layout_height="36dp"
                android:minHeight="36dp"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:text="查询"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnCabinet"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/ui_filter_button"
                android:minHeight="32dp"
                android:text="全柜"
                android:textColor="@color/ui_text"
                android:textSize="12sp" />
            <Button
                android:id="@+id/btnPrice"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:background="@drawable/ui_filter_button"
                android:minHeight="32dp"
                android:text="全价"
                android:textColor="@color/ui_text"
                android:textSize="12sp" />
            <Button
                android:id="@+id/btnType"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:background="@drawable/ui_filter_button"
                android:minHeight="32dp"
                android:text="全类"
                android:textColor="@color/ui_text"
                android:textSize="12sp" />
        </LinearLayout>
    </com.ajmst.android.ui.HeroHeaderLayout>

    <TextView
        android:id="@+id/tvResultCount"
        style="@style/UiSectionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="14dp"
        android:paddingTop="9dp"
        android:paddingRight="14dp"
        android:paddingBottom="4dp"
        android:text="搜索结果" />
    <ListView
        android:id="@+id/listViewSpkfk"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:descendantFocusability="blocksDescendants"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:paddingLeft="12dp"
        android:paddingTop="4dp"
        android:paddingRight="12dp"
        android:paddingBottom="12dp"
        android:scrollbars="none" />
</LinearLayout>
</com.ajmst.android.ui.RoundedPageLayout>
