<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:paddingBottom="6dp">
    <Button
        android:id="@+id/btnDeleteItem"
        android:layout_width="72dp"
        android:layout_height="58dp"
        android:layout_gravity="right|top"
        android:background="@drawable/ui_delete_button"
        android:focusable="false"
        android:text="删除"
        android:textColor="@color/ui_surface"
        android:textSize="15sp"
        android:textStyle="bold" />
    <LinearLayout
        android:id="@+id/orderRowForeground"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@drawable/ui_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="12dp">
        <TextView
            android:id="@+id/textViewSeq"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/ui_badge"
            android:gravity="center"
            android:textColor="@color/ui_accent"
            android:textSize="11sp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="9dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvSpmch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/ui_text"
                android:textSize="16sp"
                android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/tvShl" android:layout_width="wrap_content" android:layout_height="30dp" android:background="@drawable/ui_edit_quantity" android:clickable="true" android:focusable="false" android:gravity="center_vertical" android:paddingLeft="7dp" android:paddingRight="7dp" android:singleLine="true" android:textColor="@color/ui_accent_dark" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvShpgg" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="5dp" android:layout_weight="1" android:ellipsize="end" android:singleLine="true" android:textColor="@color/ui_muted" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:gravity="right" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/tvPriceUnit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="3dp" android:singleLine="true" android:textColor="@color/ui_muted" android:textSize="9sp" />
                <TextView android:id="@+id/tvLshj" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:textColor="@color/ui_muted" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="4dp" android:text="小计" android:textColor="@color/ui_muted" android:textSize="10sp" />
                <TextView android:id="@+id/tvItemAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ui_price" android:textSize="17sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
