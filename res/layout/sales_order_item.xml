<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:paddingBottom="6dp">
    <Button
        android:id="@+id/btnDeleteItem"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="right|top"
        android:layout_marginTop="5dp"
        android:layout_marginRight="8dp"
        android:background="@drawable/ui_delete_button"
        android:focusable="false"
        android:minHeight="48dp"
        android:minWidth="48dp"
        android:paddingLeft="0dp"
        android:paddingRight="0dp"
        android:text="删除"
        android:textColor="@color/ui_surface"
        android:textSize="14sp"
        android:textStyle="bold" />
    <LinearLayout
        android:id="@+id/orderRowForeground"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@drawable/ui_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="12dp">
        <TextView
            android:id="@+id/textViewSeq"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/ui_badge"
            android:gravity="center"
            android:textColor="@color/ui_accent"
            android:textSize="11sp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="9dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvSpmch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@color/ui_text"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/tvShpgg" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:singleLine="true" android:textColor="@color/ui_muted" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:gravity="right" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/tvLshj" style="@style/UiListUnitPrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="82dp" android:singleLine="true" />
                <TextView android:id="@+id/tvPriceUnit" style="@style/UiListPriceUnit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="2dp" android:singleLine="true" android:text="/10g" android:visibility="gone" />
            </LinearLayout>
            <TextView android:id="@+id/tvItemAmount" style="@style/UiListSubtotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="right" android:singleLine="true" />
        </LinearLayout>
        <Button
            android:id="@+id/btnEditQuantity"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/ui_edit_button"
            android:contentDescription="修改数量"
            android:focusable="false"
            android:minHeight="48dp"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:text="✎"
            android:textColor="@color/ui_accent"
            android:textSize="22sp" />
    </LinearLayout>
</FrameLayout>
