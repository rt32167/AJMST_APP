<?xml version="1.0" encoding="utf-8"?>
<com.ajmst.android.ui.RoundedPageLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <com.ajmst.android.ui.HeroHeaderLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/ui_back_button"
            android:contentDescription="返回商品查询"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ui_back_arrow" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:text="销售单"
            android:textColor="@color/ui_text"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvOrderNo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="right"
            android:singleLine="true"
            android:textColor="@color/ui_accent_dark"
            android:textSize="10sp" />
    </com.ajmst.android.ui.HeroHeaderLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="12dp"
        android:background="@drawable/ui_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="8dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="顾客"
            android:textColor="@color/ui_muted"
            android:textSize="12sp" />
        <EditText
            android:id="@+id/edtCustomer"
            style="@style/UiInput"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="姓名（可选）"
            android:inputType="textPersonName"
            android:minHeight="42dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="商品明细"
            android:textColor="@color/ui_text"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="左滑或长按删除 · 左侧边缘右滑返回"
            android:textColor="@color/ui_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <com.ajmst.android.salesorder.OrderSwipeListView
        android:id="@+id/lvOrderItem"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:paddingLeft="12dp"
        android:paddingTop="4dp"
        android:paddingRight="12dp"
        android:scrollbars="none" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@drawable/ui_footer"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="12dp">
        <TextView
            android:id="@+id/tvCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ui_muted"
            android:textSize="13sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" 项 · 合计 ¥"
            android:textColor="@color/ui_muted"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/ui_accent_dark"
            android:textSize="21sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btnFinish"
            style="@style/UiPrimaryButton"
            android:layout_width="86dp"
            android:layout_height="44dp"
            android:text="结算" />
    </LinearLayout>
</LinearLayout>
</com.ajmst.android.ui.RoundedPageLayout>
