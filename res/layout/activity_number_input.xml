<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#99000000">
<LinearLayout android:layout_width="260dp" android:layout_height="wrap_content" android:layout_gravity="center" android:background="@drawable/ui_card" android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/textInputTitle" style="@style/UiPageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="输入数量" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
        <EditText android:id="@+id/editTextInputNumber" style="@style/UiInput" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:focusable="false" android:gravity="right|center_vertical" android:hint="0" android:textSize="23sp" />
        <Button android:id="@+id/buttonBackSpace" style="@style/UiSecondaryButton" android:layout_width="58dp" android:layout_height="52dp" android:layout_marginLeft="8dp" android:tag="Backspace" android:text="⌫" android:textSize="24sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
        <Button android:id="@+id/buttonNum1" style="@style/UiSecondaryButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_margin="3dp" android:layout_weight="1" android:tag="1" android:text="1" android:textSize="21sp" />
        <Button android:id="@+id/buttonNum2" style="@style/UiSecondaryButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_margin="3dp" android:layout_weight="1" android:tag="2" android:text="2" android:textSize="21sp" />
        <Button android:id="@+id/buttonNum3" style="@style/UiSecondaryButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_margin="3dp" android:layout_weight="1" android:tag="3" android:text="3" android:textSize="21sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/buttonNum4" style="@style/UiSecondaryButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_margin="3dp" android:layout_weight="1" android:tag="4" android:text="4" android:textSize="21sp" />
        <Button android:id="@+id/buttonNum5" style="@style/UiSecondaryButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_margin="3dp" android:layout_weight="1" android:tag="5" android:text="5" android:textSize="21sp" />
        <Button android:id="@+id/buttonNum6" style="@style/UiSecondaryButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_margin="3dp" android:layout_weight="1" android:tag="6" android:text="6" android:textSize="21sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/buttonNum7" style="@style/UiSecondaryButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_margin="3dp" android:layout_weight="1" android:tag="7" android:text="7" android:textSize="21sp" />
        <Button android:id="@+id/buttonNum8" style="@style/UiSecondaryButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_margin="3dp" android:layout_weight="1" android:tag="8" android:text="8" android:textSize="21sp" />
        <Button android:id="@+id/buttonNum9" style="@style/UiSecondaryButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_margin="3dp" android:layout_weight="1" android:tag="9" android:text="9" android:textSize="21sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/buttonDecimalPoint" style="@style/UiSecondaryButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_margin="3dp" android:layout_weight="1" android:tag="." android:text="." android:textSize="21sp" />
        <Button android:id="@+id/buttonNum0" style="@style/UiSecondaryButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_margin="3dp" android:layout_weight="1" android:tag="0" android:text="0" android:textSize="21sp" />
        <Button android:id="@+id/buttonClear" style="@style/UiSecondaryButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_margin="3dp" android:layout_weight="1" android:tag="Clear" android:text="清空" android:textSize="16sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
        <Button android:id="@+id/buttonCancel" style="@style/UiSecondaryButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:tag="Cancel" android:text="取消" />
        <Button android:id="@+id/buttonConfirm" style="@style/UiPrimaryButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_marginLeft="8dp" android:layout_weight="1" android:tag="Confirm" android:text="确认" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
